# ---------------------------------------------------------------------------
# Copy to .env.prod and fill in. .env.prod is gitignored and must stay so.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Not in the nightly backup on the VM (/var/backups/rdp is readable by the
# zabbix user), so the master copy belongs in the password manager.
# Changes at DNS cutover: SERVER_NAME, REDIRECT_SERVER_NAME, CANONICAL_HOST,
# NEXT_PUBLIC_URL, SITE_URL.
# ---------------------------------------------------------------------------

# --- Postgres (never published to the host) ---
# POSTGRES_PASSWORD must be alphanumeric: '/' '+' '=' break DATABASE_URL's
# userinfo parsing, so a base64 one fails about one time in three. Use
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c48
POSTGRES_DB=grass
POSTGRES_USER=grass
POSTGRES_PASSWORD=

# --- Strapi ---
# GCS_BUCKET_NAME is deliberately ABSENT: cms/config/plugins.ts gates the GCS
# upload provider on it, so omitting it IS the revert to local uploads.
# Generate each with `openssl rand -base64 32`; APP_KEYS takes a list too.
# Strapi stores only token hashes, salted with the two SALTs: changing one
# invalidates every API and transfer token but leaves its row behind.
APP_KEYS=
JWT_SECRET=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=

# --- Tiler ---
# Whole service-account JSON on one line. See
# cloud_functions/earth_engine_tiler/src/earth-engine-utils.ts.
EE_CREDENTIALS_JSON=

# --- Client: build-time (NEXT_PUBLIC_* are inlined by next build) ---
# Relative, so one build serves any domain. Server-side code cannot use it.
NEXT_PUBLIC_API_URL=/cms/api/
# Absolute; client/src/env.mjs validates with z.string().url(). Build-time
# fallback for metadataBase only, overridden at runtime by SITE_URL.
NEXT_PUBLIC_URL=https://localhost
# Must be pk.: it is inlined into the public bundle, and CI refuses sk.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Client: runtime (server-only, never in the browser bundle) ---
# Required by client/src/env.mjs; the server renders 500 without it.
TRANSIFEX_TOKEN=
# Direct over the Docker network, skipping nginx. Must be absolute: Node has
# no origin to resolve a relative URL against.
CMS_INTERNAL_API_URL=http://cms:1337/api/
# Runtime origin for metadataBase; overrides NEXT_PUBLIC_URL without a rebuild.
SITE_URL=https://localhost

# --- nginx ---
# Space-separated names this stack serves.
SERVER_NAME=localhost
# Space-separated names that 301 to CANONICAL_HOST; point at a name that never
# resolves to disable the redirect.
REDIRECT_SERVER_NAME=alias.localhost
CANONICAL_HOST=localhost
# Host dir nginx serves /.well-known/acme-challenge from. Required, and on the
# VM it MUST be /var/www/certbot: certbot runs on the host and cannot write
# into a Docker volume, so anything else 404s every challenge.
CERTBOT_WEBROOT=./.certbot-www

# --- Deployment state (written by deploy-release.sh, never by hand) ---
# Assembled into the image name by docker-compose.prod.yml as
# `${IMAGE_PREFIX:-}rdp-<svc>:${IMAGE_TAG:-local}`, giving for example
# 127.0.0.1:5000/rdp-cms:v1.2.0. The prefix carries its own trailing slash,
# because a registry is a prefix on the name and not a separate field.
#
# IMAGE_TAG has two shapes, and the shape is meaningful:
#   v1.2.0                    a release; registry-gc.sh never collects it
#   20261016T105124Z-299b454  a version-less build: UTC stamp + git short
#                             sha, collected past KEEP, disposable by design
#
# Commented out so the key-parity diff in infrastructure/vm/README.md stays
# clean. Until the first deploy writes them, compose falls back to
# rdp-<svc>:local, which does not exist on the VM, and rebuilds from the
# working tree instead of using the released images.
#IMAGE_PREFIX=127.0.0.1:5000/
#IMAGE_TAG=
