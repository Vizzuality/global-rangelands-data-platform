# ---------------------------------------------------------------------------
# Copy to .env.prod and fill in. .env.prod is gitignored and must stay so.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ---------------------------------------------------------------------------

# --- Postgres (never published to the host) ---
# Keep POSTGRES_PASSWORD alphanumeric. It is interpolated into DATABASE_URL's
# userinfo, where a '/' terminates the authority component and '+' / '=' are
# handled inconsistently across URI parsers -- so a base64 password (openssl
# rand -base64) breaks the CMS connection roughly one time in three. Generate
# with:  tr -dc 'A-Za-z0-9' </dev/urandom | head -c48
POSTGRES_DB=grass
POSTGRES_USER=grass
POSTGRES_PASSWORD=

# --- Strapi ---
# GCS_BUCKET_NAME is deliberately ABSENT. cms/config/plugins.ts gates the Google
# Cloud Storage upload provider on it, so omitting the variable IS the revert to
# local filesystem uploads. Do not add it, even empty, without reading that file.
#
# Generate each of these with: openssl rand -base64 32
# APP_KEYS is read with env.array(), so it accepts a comma-separated list; a
# single value is valid.
APP_KEYS=
JWT_SECRET=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=

# --- Tiler ---
# The whole service-account JSON on one line. See
# cloud_functions/earth_engine_tiler/src/earth-engine-utils.ts.
EE_CREDENTIALS_JSON=

# --- Client: build-time (NEXT_PUBLIC_* are inlined by next build) ---
# Relative, so the browser bundle carries no hostname and the same build serves
# any domain. Server-side code cannot use this; see CMS_INTERNAL_API_URL below.
NEXT_PUBLIC_API_URL=/cms/api/
# Absolute: client/src/env.mjs validates it with z.string().url(). Only a
# build-time fallback for metadataBase now -- SITE_URL overrides it at runtime.
NEXT_PUBLIC_URL=https://localhost
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Client: runtime (server-only, never in the browser bundle) ---
# client/src/env.mjs requires this. Server renders 500 without it.
TRANSIFEX_TOKEN=
# Server-side fetches go direct over the Docker network, skipping nginx. Must be
# absolute -- a relative URL has no origin to resolve against on Node.
CMS_INTERNAL_API_URL=http://cms:1337/api/
# Runtime origin for metadataBase. Overrides NEXT_PUBLIC_URL without a rebuild.
SITE_URL=https://localhost

# --- nginx ---
# Space-separated names this stack serves.
SERVER_NAME=localhost
# Space-separated names that 301 to CANONICAL_HOST. Point at a name that never
# resolves to disable the redirect.
REDIRECT_SERVER_NAME=alias.localhost
CANONICAL_HOST=localhost
