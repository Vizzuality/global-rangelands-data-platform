{
  "kind": "collectionType",
  "collectionName": "datasets",
  "info": {
    "singularName": "dataset",
    "pluralName": "datasets",
    "displayName": "Dataset",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {},
      "unique": true
    },
    "type": {
      "pluginOptions": {},
      "type": "enumeration",
      "enum": [
        "Group",
        "Temporal",
        "Simple",
        "Temporal-Group"
      ],
      "default": "Group",
      "required": true
    },
    "layers": {
      "displayName": "Layer",
      "type": "component",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "default.layer",
      "required": true
    },
    "citations": {
      "type": "component",
      "repeatable": true,
      "pluginOptions": {},
      "component": "default.citations"
    },
    "sources": {
      "type": "component",
      "repeatable": false,
      "pluginOptions": {},
      "component": "default.source"
    },
    "slug": {
      "pluginOptions": {},
      "type": "string"
    },
    "description": {
      "pluginOptions": {},
      "type": "richtext"
    },
    "translations": {
      "type": "component",
      "repeatable": true,
      "pluginOptions": {},
      "component": "translations.dataset-translation",
      "max": 2
    },
    "story": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::story.story",
      "inversedBy": "datasets"
    },
    "short_description": {
      "type": "string",
      "required": false
    }
  }
}
