# syntax=docker/dockerfile:1

# deps — lockfile only, so source edits don't reinstall dependencies.
FROM node:24.15.0-bookworm-slim AS deps

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml .npmrc ./

RUN pnpm install --frozen-lockfile

# build
FROM node:24.15.0-bookworm-slim AS build

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

# NEXT_PUBLIC_* are inlined into the bundle by next build, so they must be set
# here, not just at runtime. compose passes them from .env.prod; CI supplies
# them via the generated .env.local, which COPY . . picks up.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_URL
ARG NEXT_PUBLIC_MAPBOX_TOKEN
ARG CMS_INTERNAL_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_URL=$NEXT_PUBLIC_URL \
    NEXT_PUBLIC_MAPBOX_TOKEN=$NEXT_PUBLIC_MAPBOX_TOKEN \
    CMS_INTERNAL_API_URL=$CMS_INTERNAL_API_URL

# src/env.mjs declares TRANSIFEX_TOKEN as a required server variable and
# validates it when the module loads, which happens during the build's route
# analysis. The real token is only ever used per request (src/i18n/request.ts
# calls tx.init inside getRequestConfig), so a placeholder satisfies the build
# and no real secret enters it. Verified: a build with a bogus token succeeds.
ENV TRANSIFEX_TOKEN=build-only-placeholder

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN pnpm build

# runner — standalone output only; see `output: "standalone"` in next.config.mjs.
FROM node:24.15.0-bookworm-slim AS runner

# Patch the image that ships. Build stages are discarded, so don't patch there.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
# server.js binds HOSTNAME; without this it can bind loopback only.
ENV HOSTNAME=0.0.0.0

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=build --chown=nextjs:nodejs /app/public ./public
COPY --from=build --chown=nextjs:nodejs /app/entrypoint.sh ./entrypoint.sh
COPY --from=build --chown=nextjs:nodejs /app/next.config.mjs ./next.config.mjs
# Config is baked in: Cloud Run passes no runtime env vars, so this file is the
# only source. CI generates it from GH secrets (generate-env-file-from-json).
COPY --from=build --chown=nextjs:nodejs /app/.env.local ./.env.local

USER nextjs

EXPOSE 3000

ENTRYPOINT ["/app/entrypoint.sh"]
