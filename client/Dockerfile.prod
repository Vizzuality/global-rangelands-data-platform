# syntax=docker/dockerfile:1

# deps — lockfile only, so source edits don't reinstall dependencies.
FROM node:24.15.0-bookworm-slim AS deps

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml .npmrc ./

RUN pnpm install --frozen-lockfile

# build
FROM node:24.15.0-bookworm-slim AS build

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

# NEXT_PUBLIC_* are inlined by `next build`, so they must reach the build.
# compose passes them as build args from .env.prod; CI passes none and
# supplies them via the generated .env.local that COPY . . picks up.
# ARG only, never ENV: an unpassed ARG is genuinely absent, where an ENV
# would be an empty string, and @next/env only fills variables that are
# absent -- so "" would beat .env.local and every value would inline empty.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_URL
ARG NEXT_PUBLIC_MAPBOX_TOKEN
ARG CMS_INTERNAL_API_URL

# src/env.mjs requires TRANSIFEX_TOKEN and validates it at module load, which
# happens during route analysis. The real one is only used per request
# (src/i18n/request.ts), so a placeholder builds and ships no secret.
ENV TRANSIFEX_TOKEN=build-only-placeholder

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# The runner copies .env.local unconditionally; a clean checkout has none.
RUN touch .env.local

RUN pnpm build

# runner — standalone output only; see `output: "standalone"` in next.config.mjs.
FROM node:24.15.0-bookworm-slim AS runner

# Patch the image that ships. Build stages are discarded, so don't patch there.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
# server.js binds HOSTNAME; without this it can bind loopback only.
ENV HOSTNAME=0.0.0.0

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=build --chown=nextjs:nodejs /app/public ./public
COPY --from=build --chown=nextjs:nodejs /app/entrypoint.sh ./entrypoint.sh
COPY --from=build --chown=nextjs:nodejs /app/next.config.mjs ./next.config.mjs
# Config is baked in: Cloud Run passes no runtime env vars, so this file is the
# only source. CI generates it from GH secrets (generate-env-file-from-json).
COPY --from=build --chown=nextjs:nodejs /app/.env.local ./.env.local

# The VM passes every runtime value through compose, so it builds with
# STRIP_ENV_FILES=1 and ships no env file -- otherwise the image carries
# whatever .env.local sat in the build context, on a laptop their own.
# Defaults to 0, leaving the Cloud Run path above unchanged. GRASS-392.
ARG STRIP_ENV_FILES=0
RUN if [ "$STRIP_ENV_FILES" = "1" ]; then rm -f ./.env.local; fi

USER nextjs

EXPOSE 3000

ENTRYPOINT ["/app/entrypoint.sh"]
