# If client pnpm-lock.yaml has changed, run pnpm to install dependencies
CLIENT_CHANGED=`git diff HEAD@{1} --stat -- ./client/pnpm-lock.yaml | wc -l`
if [ "$CLIENT_CHANGED" -gt 0 ];
then
    echo "client/pnpm-lock.yaml has changed!"
    cd ./client && pnpm install
fi

# If CMS pnpm-lock.yaml has changed, run pnpm to install dependencies
CMS_CHANGED=`git diff HEAD@{1} --stat -- ./cms/pnpm-lock.yaml | wc -l`
if [ "$CMS_CHANGED" -gt 0 ];
then
    echo "cms/pnpm-lock.yaml has changed!"
    cd ./cms && pnpm install
fi

# If CMS env file exists and there are changes to the config sync files, import them into the DB
CMS_CONFIG_CHANGED=`git diff HEAD@{1} --stat -- ./cms/config/sync/ | wc -l`
SCRIPT_DIR="$(pwd)"
CMS_ENV_FILE="$SCRIPT_DIR/../cms/.env"
if [ ! -f "$CMS_ENV_FILE" ] ; then
    echo "CMS env file does not exist, can't import config."
elif [ -f "$CMS_ENV_FILE" ] && [ "$CMS_CONFIG_CHANGED" -gt 0 ]; then
    echo "Importing CMS config..."
    cd ./cms && pnpm config-sync import -y
fi
